<%- include("../partials/head.ejs") %>

<body class="min-h-screen bg-slate-950 text-slate-100">
  <%- include("../partials/nav.ejs") %>

  <main class="mx-auto max-w-6xl px-4 py-10 sm:px-6 lg:px-8">

    <!-- Breadcrumb -->
    <div class="mb-6">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-sm font-medium text-slate-400 transition hover:text-white"
      >
        ← Back to homes
      </a>
    </div>

    <!-- Page Header -->
    <div class="mb-8">
      <p class="mb-2 text-sm font-medium uppercase tracking-wider text-indigo-400">
        Property Details
      </p>

      <h1 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">
        <%= home.houseName %>
      </h1>

      <p class="mt-2 text-slate-400">
        Discover your perfect place to stay.
      </p>
    </div>

    <!-- Property Card -->
    <div
      class="overflow-hidden rounded-3xl border border-slate-800 bg-slate-900 shadow-2xl shadow-black/20"
    >

      <!-- Property Image -->
      <div class="relative h-72 overflow-hidden sm:h-96 lg:h-[500px]">
        <img
          src="<%= home.image %>"
          alt="<%= home.houseName %>"
          class="h-full w-full object-cover transition duration-500 hover:scale-105"
        />

        <!-- Image Overlay -->
        <div
          class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"
        ></div>

        <!-- Rating -->
        <div
          class="absolute right-5 top-5 rounded-full border border-white/10 bg-slate-950/80 px-4 py-2 text-sm font-medium text-white backdrop-blur-md"
        >
          ⭐ <%= home.rating %>
        </div>
      </div>

      <!-- Property Content -->
      <div class="p-6 sm:p-8">

        <div class="grid gap-8 lg:grid-cols-[1fr_300px]">

          <!-- Left Content -->
          <div>

            <!-- Title -->
            <div class="mb-6">
              <h2 class="text-2xl font-bold text-white sm:text-3xl">
                <%= home.houseName %>
              </h2>

              <p class="mt-2 text-slate-400">
                Comfortable stay with everything you need.
              </p>
            </div>

            <!-- Property Features -->
            <div
              class="mb-8 grid grid-cols-2 gap-3 sm:grid-cols-3"
            >
              <div
                class="rounded-xl border border-slate-800 bg-slate-950/50 p-4"
              >
                <p class="text-xs uppercase tracking-wide text-slate-500">
                  Rating
                </p>
                <p class="mt-1 font-semibold text-white">
                  ⭐ <%= home.rating %>
                </p>
              </div>

              <div
                class="rounded-xl border border-slate-800 bg-slate-950/50 p-4"
              >
                <p class="text-xs uppercase tracking-wide text-slate-500">
                  Property
                </p>
                <p class="mt-1 font-semibold text-white">
                  Premium Home
                </p>
              </div>

              <div
                class="rounded-xl border border-slate-800 bg-slate-950/50 p-4"
              >
                <p class="text-xs uppercase tracking-wide text-slate-500">
                  Stay
                </p>
                <p class="mt-1 font-semibold text-white">
                  Per Night
                </p>
              </div>
            </div>

            <!-- Description -->
            <div>
              <h3 class="text-lg font-semibold text-white">
                About this property
              </h3>

              <p class="mt-3 max-w-2xl leading-7 text-slate-400">
                Enjoy a comfortable and relaxing stay at
                <%= home.houseName %>. This property is designed to provide
                guests with a convenient and enjoyable experience.
              </p>
            </div>

          </div>

          <!-- Booking Box -->
          <div
            class="h-fit rounded-2xl border border-slate-800 bg-slate-950 p-6"
          >

            <p class="text-sm text-slate-400">
              Starting from
            </p>

            <div class="mt-1 flex items-baseline gap-2">
              <span class="text-3xl font-bold text-white">
                $<%= home.price %>
              </span>

              <span class="text-sm text-slate-500">
                / night
              </span>
            </div>

            <div class="my-6 h-px bg-slate-800"></div>

            <div class="space-y-3 text-sm">
              <div class="flex justify-between">
                <span class="text-slate-400">Rating</span>
                <span class="font-medium text-white">
                  ⭐ <%= home.rating %>
                </span>
              </div>

              <div class="flex justify-between">
                <span class="text-slate-400">Price</span>
                <span class="font-medium text-white">
                  $<%= home.price %>/night
                </span>
              </div>
            </div>

            <%- include("../partials/bookingButton.ejs", {home:home}) %>
            

          </div>

        </div>
      </div>
    </div>

  </main>
</body>

</html>

