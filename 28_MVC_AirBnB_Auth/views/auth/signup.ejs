<%- include("../partials/head.ejs") %>

<body class="min-h-screen bg-slate-950 text-white">
  <%- include("../partials/nav.ejs") %>

  <!-- Form Section -->

  <main class="mx-auto max-w-2xl px-6 py-12">
    <!-- Header -->
    <div class="mb-8 text-center">
      <p class="text-sm font-medium uppercase tracking-widest text-slate-400">
        Property Listing
      </p>

      <h1 class="mt-3 text-3xl font-bold tracking-tight">
        Create Your Account
      </h1>

      <p class="mt-2 text-slate-400">
        Enter your details to create your account.
      </p>
    </div>

    <!-- Form Card -->
    <div
      class="rounded-2xl border border-slate-800 bg-slate-900 p-6 shadow-xl sm:p-8"
    >
      <form action="/signup" method="POST" class="space-y-6">
        <!-- Name Fields -->
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
          <!-- First Name -->
          <div>
            <label
              for="firstName"
              class="mb-2 block text-sm font-medium text-slate-200"
            >
              First Name
            </label>

            <input
              type="text"
              id="firstName"
              name="firstName"
              placeholder="Enter first name"
              required
              class="w-full rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-white focus:ring-1 focus:ring-white"
            />
          </div>

          <!-- Last Name -->
          <div>
            <label
              for="lastName"
              class="mb-2 block text-sm font-medium text-slate-200"
            >
              Last Name
            </label>

            <input
              type="text"
              id="lastName"
              name="lastName"
              placeholder="Enter last name"
              required
              class="w-full rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-white focus:ring-1 focus:ring-white"
            />
          </div>
        </div>

        <!-- Email -->
        <div>
          <label
            for="email"
            class="mb-2 block text-sm font-medium text-slate-200"
          >
            Email Address
          </label>

          <input
            type="email"
            id="email"
            name="email"
            placeholder="Enter your email"
            required
            class="w-full rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-white focus:ring-1 focus:ring-white"
          />
        </div>

        <!-- Password -->
        <div>
          <label
            for="password"
            class="mb-2 block text-sm font-medium text-slate-200"
          >
            Password
          </label>

          <input
            type="password"
            id="password"
            name="password"
            placeholder="Create a password"
            required
            class="w-full rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-white focus:ring-1 focus:ring-white"
          />
        </div>

        <!-- Confirm Password -->
        <div>
          <label
            for="confirm-password"
            class="mb-2 block text-sm font-medium text-slate-200"
          >
            Confirm Password
          </label>

          <input
            type="password"
            id="confirm-password"
            name="confirm-password"
            placeholder="Enter your password again"
            required
            class="w-full rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-white focus:ring-1 focus:ring-white"
          />
        </div>

        <!-- User Type -->
        <fieldset>
          <legend class="mb-3 block text-sm font-medium text-slate-200">
            Account Type
          </legend>

          <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
            <!-- Guest -->
            <label
              class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 transition hover:border-slate-500"
            >
              <input
                type="radio"
                name="userType"
                value="guest"
                required
                class="h-4 w-4 accent-white"
              />

              <div>
                <p class="text-sm font-medium text-white">Guest</p>

                <p class="text-xs text-slate-400">Book and manage properties</p>
              </div>
            </label>

            <!-- Host -->
            <label
              class="flex cursor-pointer items-center gap-3 rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 transition hover:border-slate-500"
            >
              <input
                type="radio"
                name="userType"
                value="host"
                required
                class="h-4 w-4 accent-white"
              />

              <div>
                <p class="text-sm font-medium text-white">Host</p>

                <p class="text-xs text-slate-400">
                  List and manage your properties
                </p>
              </div>
            </label>
          </div>
        </fieldset>

        <!-- Terms -->
        <label
          class="flex cursor-pointer items-start gap-3 rounded-lg border border-slate-800 bg-slate-800/50 p-4"
        >
          <input
            type="checkbox"
            name="termAccepted"
            required
            class="mt-1 h-4 w-4 shrink-0 accent-white"
          />

          <span class="text-sm leading-5 text-slate-300">
            I agree to the
            <a
              href="#"
              class="font-medium text-white underline underline-offset-4 hover:text-slate-300"
            >
              Terms and Conditions
            </a>
            and confirm that the information provided is correct.
          </span>
        </label>

        <!-- Submit -->
        <button
          type="submit"
          class="w-full rounded-lg bg-white px-5 py-3.5 text-sm font-semibold text-slate-900 transition hover:bg-slate-200 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-slate-900"
        >
          Create Account
        </button>

        <!-- Login Link -->
        <p class="text-center text-sm text-slate-400">
          Already have an account?
          <a href="/login" class="font-medium text-white hover:text-slate-300">
            Login
          </a>
        </p>
      </form>
    </div>
  </main>
</body>
</html>
