<%- include("../partials/head.ejs") %>

  <body class="min-h-screen bg-slate-950 text-white">

    <%- include("../partials/nav.ejs") %>

    <!-- Form Section -->
    <main class="mx-auto max-w-2xl px-6 py-12">

      <div class="mb-8 text-center">

        <p class="text-sm font-medium uppercase tracking-widest text-slate-400">
          Property Listing
        </p>

        <h1 class="mt-3 text-3xl font-bold">
          <%= editing ? "Update": "Add"%> Your Home
        </h1>

        <p class="mt-2 text-slate-400">
          Enter your property details to add it to our listings.
        </p>

      </div>

      <!-- Form Card -->
      <div class="rounded-2xl border border-slate-800 bg-slate-900 p-6 sm:p-8">

        <form action="/user/<%= editing ? "edit-home": "output-home" %> " method="POST" class="space-y-6">

          <input type="hidden" name="id" value="<%= home ? home._id : "" %>">

          <!-- House Name -->
          <div>
            <label
              for="houseName"
              class="mb-2 block text-sm font-medium text-slate-200"
            >
              House Name
            </label>

            <input
              type="text"
              id="houseName"
              name="houseName"
               value="<%= home ? home.houseName : "" %>"
              placeholder="Enter house name"
              required
              class="w-full rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-slate-500"
            />
          </div>

          <!-- Price -->
          <div>
            <label
              for="price"
              class="mb-2 block text-sm font-medium text-slate-200"
            >
              Price per Night
            </label>

            <input
              type="number"
              id="price"
              value="<%= home ? home.price : "" %>"
              name="price"
              placeholder="Enter price"
              required
              class="w-full rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-slate-500"
            />
          </div>

          <!-- Rating -->
          <div>
            <label
              for="rating"
              class="mb-2 block text-sm font-medium text-slate-200"
            >
              Rating
            </label>

            <input
              type="number"
              id="rating"
              name="rating"
              value="<%= home ? home.rating : "" %>"
              placeholder="Enter rating (1 - 5)"
              min="1"
              max="5"
              step="0.1"
              required
              class="w-full rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-slate-500"
            />
          </div>

          <!-- Image -->
          <div>
            <label
              for="image"
              class="mb-2 block text-sm font-medium text-slate-200"
            >
              Upload Image
            </label>

            <input
              type="file"
              id="image"
              name="image"
              accept="image/jpeg, image/jpg, image/png"
              class="w-full rounded-lg border border-slate-700 bg-slate-800 px-4 py-3 text-white placeholder-slate-500 outline-none transition focus:border-slate-500"
            />
          </div>

          <!-- Submit -->
          <input
            type="submit" value="<%= editing ? "Update" : "Add" %>"
            class="w-full rounded-lg bg-white px-5 py-3 text-sm font-semibold text-slate-900 transition hover:bg-slate-200"
          >

        </form>

      </div>

    </main>

  </body>
</html>

