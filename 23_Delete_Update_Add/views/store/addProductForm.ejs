<%- include("../partials/head.ejs") %>

<body class="min-h-screen bg-slate-100 text-slate-900">

  <%- include("../partials/nav.ejs") %>

  <main class="flex justify-center px-6 py-10">
    <div class="w-full max-w-md rounded-lg bg-white p-6 shadow">

      <h1 class="mb-6 text-2xl font-semibold">
        <%= editing ? "Edit Product" : "Add Product" %>
      </h1>

      <form
        action="/<%= editing ? 'edit-product' : 'add-product' %>"
        method="post"
        class="space-y-4"
      >

        <input
          type="hidden"
          name="id"
          value="<%= product ? product.id : '' %>"
        >

        <div>
          <label
            for="name"
            class="mb-1 block text-sm font-medium text-slate-700"
          >
            Product Name
          </label>

          <input
            id="name"
            type="text"
            name="name"
            placeholder="Enter product name"
            value="<%= product ? product.name : '' %>"
            class="w-full rounded-md border border-slate-300 px-3 py-2 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
          >
        </div>

        <div>
          <label
            for="price"
            class="mb-1 block text-sm font-medium text-slate-700"
          >
            Product Price
          </label>

          <input
            id="price"
            type="number"
            name="price"
            placeholder="Enter product price"
            value="<%= product ? product.price : '' %>"
            class="w-full rounded-md border border-slate-300 px-3 py-2 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
          >
        </div>

        <div>
          <label
            for="image"
            class="mb-1 block text-sm font-medium text-slate-700"
          >
            Product Image
          </label>

          <input
            id="image"
            type="text"
            name="image"
            placeholder="Enter product image URL"
            value="<%= product ? product.image : '' %>"
            class="w-full rounded-md border border-slate-300 px-3 py-2 outline-none transition focus:border-blue-500 focus:ring-2 focus:ring-blue-200"
          >
        </div>

        <button
          type="submit"
          class="w-full rounded-md bg-blue-600 px-4 py-2 font-medium text-white transition hover:bg-blue-500"
        >
          <%= editing ? "Edit Product" : "Add Product" %>
        </button>

      </form>

    </div>
  </main>

</body>

</html>
