<%- include("../partials/head.ejs") %>

<body class="min-h-screen bg-slate-100 text-slate-900">

  <%- include("../partials/nav.ejs") %>

  <main class="px-6 py-10">
    <div class="mx-auto max-w-5xl">

      <h1 class="mb-6 text-2xl font-semibold">
        Your Cart
      </h1>

      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">

        <% products.forEach(product => { %>

          <div class="rounded-lg bg-white p-5 shadow">

            <div class="mb-4 space-y-3">

              <div>
                <p class="text-sm text-slate-500">Product Name</p>
                <p class="font-medium">
                  <%= product.name %>
                </p>
              </div>

              <div>
                <p class="text-sm text-slate-500">Price</p>
                <p class="font-medium">
                  ৳ <%= product.price %>
                </p>
              </div>

              <div>
                <p class="text-sm text-slate-500">Image</p>
                <p class="break-all text-sm text-slate-600">
                  <%= product.image %>
                </p>
              </div>

            </div>

            <div class="flex items-center gap-2 border-t border-slate-200 pt-4">

              <a
                href="/view-detailes/<%= product.id %>"
                class="rounded-md bg-blue-600 px-3 py-2 text-sm font-medium text-white transition hover:bg-blue-500"
              >
                View Details
              </a>

              <form
                action="/cart/delete-product/<%= product.id %>"
                method="post"
              >
                <button
                  type="submit"
                  class="rounded-md bg-red-600 px-3 py-2 text-sm font-medium text-white transition hover:bg-red-500"
                >
                  Delete
                </button>
              </form>

            </div>

          </div>

        <% }) %>

      </div>

    </div>
  </main>

</body>

</html>
