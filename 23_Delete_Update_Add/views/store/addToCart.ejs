<%- include("../partials/head.ejs") %>
<body>
   <%- include("../partials/nav.ejs") %>
   <h1>Showings your carts :</h1>
   <ul>
    <% products.forEach(product => { %>
        <li>
           <%= product.name %>
        </li>
        <li>
           <%= product.price %>
        </li>
        <li>
           <%= product.image %>
        </li>
        <a href="/view-detailes/<%= product.id %>">View Detailes</a>
   <% }) %>
   </ul>
</body>
</html>